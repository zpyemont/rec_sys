# rec_sys Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env with actual secrets to version control

# ============================================
# REQUIRED - Database
# ============================================
# PostgreSQL connection (use either DSN or individual fields)
POSTGRES_DSN=postgresql://user:password@host:port/database
# OR use individual fields:
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=product

# ============================================
# OPTIONAL - Caching
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# OPTIONAL - BigQuery (for analytics)
# ============================================
BQ_PROJECT=your-gcp-project
BQ_DATASET=looksy
BQ_TABLE_PRODUCTS=products

# ============================================
# OPTIONAL - Cloud Storage
# ============================================
GCS_BUCKET_PRODUCTS=looksy_shopify_parsed

# ============================================
# OPTIONAL - Kafka (Confluent Cloud)
# ============================================
# Required only if KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_ENABLED=false

# Schema Registry (for Kafka consumers)
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# ============================================
# OPTIONAL - ML Model Server
# ============================================
# Required only if MONOLITH_ENABLED=true
MONOLITH_HOST=localhost
MONOLITH_PORT=2223  # Monolith gRPC port (not standard TFS 8500)
MONOLITH_MODEL_NAME=fashion_two_tower
MONOLITH_TIMEOUT=5.0
MONOLITH_ENABLED=false

# ============================================
# OPTIONAL - Embedding Service
# ============================================
EMBEDDING_SERVICE_URL=http://parser:8080

# ============================================
# OPTIONAL - Feature Flags
# ============================================
EMBEDDING_RETRIEVAL_ENABLED=true
USE_LEARNED_EMBEDDINGS=false
FILTER_OUT_OF_STOCK=true

# ============================================
# OPTIONAL - Server Configuration
# ============================================
SERVICE_PORT=8500
WORKER_ID=1
